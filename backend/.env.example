# ---------------------------------------------------------------------------
# Backend configuration (copy to `.env`). Nested keys use the `__` delimiter.
# All values below are the built-in defaults; uncomment to override.
# ---------------------------------------------------------------------------

# App
# APP_ENV=dev
# LOG_LEVEL=INFO
# LOG_JSON=true

# Default provider for all roles (per-role override via MODELS__<ROLE>__PROVIDER)
# PROVIDER=ollama

# Ollama
# OLLAMA__BASE_URL=http://localhost:11434
# OLLAMA__KEEP_ALIVE=30m
# OLLAMA__REQUEST_TIMEOUT_S=600   # generous for local CPU; lower for GPU/hosted
# OLLAMA__DEFAULT_NUM_CTX=8192

# Per-role models (ADR-0004: one primary chat model locally + a small embedder)
# MODELS__PLANNER__MODEL=qwen2.5-coder:7b-instruct
# MODELS__PLANNER__TEMPERATURE=0.1
# MODELS__CODER__MODEL=qwen2.5-coder:7b-instruct
# MODELS__CODER__TEMPERATURE=0.2
# MODELS__REVIEWER__MODEL=qwen2.5-coder:7b-instruct
# MODELS__REVIEWER__TEMPERATURE=0.0
# MODELS__EMBED__MODEL=nomic-embed-text

# Langfuse (self-hosted tracing; disabled by default)
# LANGFUSE__ENABLED=false
# LANGFUSE__HOST=http://localhost:3000
# LANGFUSE__PUBLIC_KEY=
# LANGFUSE__SECRET_KEY=

# Postgres + pgvector (ADR-0010)
# POSTGRES__HOST=localhost
# POSTGRES__PORT=5432
# POSTGRES__USER=appuser
# POSTGRES__PASSWORD=apppassword
# POSTGRES__DATABASE=aiswe
