# Infra secrets for docker-compose (copy to `infra/.env`).
# These must stay consistent with the backend POSTGRES__* settings.

POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=aiswe
POSTGRES_PORT=5432

# Langfuse (self-hosted). Replace the dev placeholders before any shared use.
LANGFUSE_NEXTAUTH_SECRET=changeme-dev-secret
LANGFUSE_SALT=changeme-dev-salt
